# =====================================================================
# ⚠️  SEMUA NILAI DI BAWAH INI ADALAH PLACEHOLDER — WAJIB DIGANTI
#     Salin file ini menjadi ".env" lalu isi dengan kredensial asli.
#     JANGAN commit file ".env" ke git (sudah ada di .gitignore).
# =====================================================================

# ---------- FIREBASE (Firestore + Auth, Spark Plan / Gratis) ----------
# Ambil dari: Firebase Console > Project Settings > General > Your apps > SDK config
VITE_FIREBASE_API_KEY=<<PLACEHOLDER_FIREBASE_API_KEY>>
VITE_FIREBASE_AUTH_DOMAIN=<<PLACEHOLDER_FIREBASE_AUTH_DOMAIN>>
VITE_FIREBASE_PROJECT_ID=<<PLACEHOLDER_FIREBASE_PROJECT_ID>>
VITE_FIREBASE_STORAGE_BUCKET=<<PLACEHOLDER_FIREBASE_STORAGE_BUCKET>>
VITE_FIREBASE_MESSAGING_SENDER_ID=<<PLACEHOLDER_FIREBASE_MESSAGING_SENDER_ID>>
VITE_FIREBASE_APP_ID=<<PLACEHOLDER_FIREBASE_APP_ID>>
# Opsional — hanya perlu jika Firebase Analytics diaktifkan
VITE_FIREBASE_MEASUREMENT_ID=<<PLACEHOLDER_FIREBASE_MEASUREMENT_ID>>

# ---------- CLOUDINARY (Free Plan, 25 credit/bulan) ----------
# Ambil dari: Cloudinary Dashboard > Settings
VITE_CLOUDINARY_CLOUD_NAME=<<PLACEHOLDER_CLOUDINARY_CLOUD_NAME>>
# Upload preset harus dibuat "Unsigned" di Cloudinary agar aman dipakai di client-side
VITE_CLOUDINARY_UPLOAD_PRESET=<<PLACEHOLDER_CLOUDINARY_UPLOAD_PRESET>>

# ---------- EMAILJS (Free Plan, 200 request/bulan) ----------
# Ambil dari: EmailJS Dashboard > Account > General
# Hanya dipakai untuk OTP lupa password
VITE_EMAILJS_SERVICE_ID=<<PLACEHOLDER_EMAILJS_SERVICE_ID>>
VITE_EMAILJS_PUBLIC_KEY=<<PLACEHOLDER_EMAILJS_PUBLIC_KEY>>
# Template harus punya variabel: {{email}}, {{passcode}}, {{time}}
VITE_EMAILJS_TEMPLATE_OTP=<<PLACEHOLDER_EMAILJS_TEMPLATE_OTP>>
